{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:awb:web-test:project:1.0",
  "title": "Web测试project数据契约",
  "description": "2026-11-04。设计契约；尚未接入C++运行时。结构校验后还需执行跨资源及来源语义校验。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "environmentIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      }
    },
    "caseIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      }
    },
    "dataSetIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      }
    },
    "roleIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      }
    },
    "defaultEnvironmentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "scenarioIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "SC01",
          "SC02",
          "SC03",
          "SC04"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "name",
    "environmentIds",
    "caseIds",
    "dataSetIds",
    "roleIds",
    "defaultEnvironmentId",
    "scenarioIds"
  ],
  "additionalProperties": false
}
