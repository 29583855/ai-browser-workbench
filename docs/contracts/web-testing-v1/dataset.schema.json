{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:awb:web-test:dataset:1.0",
  "title": "Web测试dataset数据契约",
  "description": "2026-11-04。设计契约；尚未接入C++运行时。结构校验后还需执行跨资源及来源语义校验。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "string",
              "number",
              "integer",
              "boolean",
              "null"
            ]
          },
          "sensitive": {
            "type": "boolean"
          }
        },
        "required": [
          "type",
          "sensitive"
        ],
        "additionalProperties": false
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "bindings": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 64,
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ],
                      "maxLength": 4096
                    }
                  },
                  "required": [
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "secretRef": {
                      "type": "string",
                      "pattern": "^secret://[a-z][a-z0-9_-]{0,63}/[a-z][a-z0-9_-]{0,63}$"
                    }
                  },
                  "required": [
                    "secretRef"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "generator": {
                      "const": "case-attempt-unique"
                    },
                    "prefix": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                    }
                  },
                  "required": [
                    "generator",
                    "prefix"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "bindings"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "projectId",
    "parameters",
    "rows"
  ],
  "additionalProperties": false
}
