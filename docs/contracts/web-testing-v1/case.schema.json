{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:awb:web-test:case:1.0",
  "title": "Web测试case数据契约",
  "description": "2026-11-04。设计契约；尚未接入C++运行时。结构校验后还需执行跨资源及来源语义校验。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "scenarioId": {
      "enum": [
        "SC01",
        "SC02",
        "SC03",
        "SC04"
      ]
    },
    "catalogIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 48,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^WT(?:0[1-9]|[1-3][0-9]|4[0-8])$"
      }
    },
    "environmentIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      }
    },
    "roleId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "dataSetId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "workflow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "setupWorkflow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "cleanup": {
      "type": "object",
      "properties": {
        "workflow": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        "onlyCreatedResources": {
          "const": true
        },
        "onFailure": {
          "const": "block-dependent-cases"
        }
      },
      "required": [
        "workflow",
        "onlyCreatedResources",
        "onFailure"
      ],
      "additionalProperties": false
    },
    "authentication": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "new-identity",
            "login-each-case",
            "reuse-verified"
          ]
        },
        "identityRef": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "secretRef": {
                  "type": "string",
                  "pattern": "^secret://[a-z][a-z0-9_-]{0,63}/[a-z][a-z0-9_-]{0,63}$"
                }
              },
              "required": [
                "secretRef"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "verifyWorkflow": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "mode",
        "identityRef",
        "verifyWorkflow"
      ],
      "additionalProperties": false
    },
    "isolation": {
      "type": "object",
      "properties": {
        "browser": {
          "const": "independent-profile"
        },
        "backend": {
          "const": "case-attempt-namespace"
        }
      },
      "required": [
        "browser",
        "backend"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3600000
        },
        "writeRetry": {
          "const": "never"
        },
        "onUnknown": {
          "const": "require-reconciliation"
        },
        "cleanupRequired": {
          "const": true
        },
        "attemptHistory": {
          "const": "append-only"
        }
      },
      "required": [
        "timeoutMs",
        "writeRetry",
        "onUnknown",
        "cleanupRequired",
        "attemptHistory"
      ],
      "additionalProperties": false
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "tags": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "projectId",
    "name",
    "scenarioId",
    "catalogIds",
    "environmentIds",
    "roleId",
    "dataSetId",
    "workflow",
    "setupWorkflow",
    "cleanup",
    "authentication",
    "isolation",
    "execution",
    "assertions",
    "tags"
  ],
  "additionalProperties": false
}
