{
  "schemaVersion": "1.0",
  "name": "入门练习：登录并查询受保护报表",
  "version": 1,
  "inputSchema": {
    "type": "object",
    "properties": {
      "user": { "type": "string", "maxLength": 64 },
      "password": { "type": "string", "maxLength": 128 }
    },
    "required": ["user", "password"],
    "additionalProperties": false
  },
  "policy": {
    "allowedOrigins": ["http://127.0.0.1:3000"],
    "maxSteps": 16,
    "maxDurationMs": 60000
  },
  "entry": "open",
  "steps": [
    {
      "id": "open",
      "type": "navigate",
      "url": "http://127.0.0.1:3000/login",
      "next": "user"
    },
    {
      "id": "user",
      "type": "fill",
      "selector": "#username",
      "value": { "input": "/user" },
      "next": "password"
    },
    {
      "id": "password",
      "type": "fill",
      "selector": "#password",
      "value": { "input": "/password" },
      "next": "login"
    },
    {
      "id": "login",
      "type": "click",
      "selector": "#login",
      "postcondition": {
        "selector": "#result",
        "expected": "logged-in",
        "timeoutMs": 5000
      },
      "next": "identity"
    },
    {
      "id": "identity",
      "type": "assertText",
      "selector": "#identity",
      "expected": { "input": "/user" },
      "timeoutMs": 5000,
      "next": "report"
    },
    {
      "id": "report",
      "type": "click",
      "selector": "#filter",
      "postcondition": {
        "selector": "#report",
        "expected": "rows:1",
        "timeoutMs": 5000
      },
      "next": "done"
    },
    {
      "id": "done",
      "type": "end"
    }
  ]
}
